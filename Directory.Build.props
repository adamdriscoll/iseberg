<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <IsebergCompact Condition="'$(PublishProfile)' == 'Compact'">true</IsebergCompact>
    <DebugType Condition="'$(IsebergCompact)' == 'true'">embedded</DebugType>
  </PropertyGroup>
</Project>
