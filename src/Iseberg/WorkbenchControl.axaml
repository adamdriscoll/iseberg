<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:local="using:Iseberg"
        x:Class="Iseberg.WorkbenchControl">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Menu x:Name="WorkbenchMenu" Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" Tag="New" Click="OnAction" />
        <MenuItem Header="_Open..." InputGesture="Ctrl+O" Tag="Open" Click="OnAction" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Tag="Save" Click="OnAction" />
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Tag="SaveAs" Click="OnAction" />
        <MenuItem Header="Save A_ll" Tag="SaveAll" Click="OnAction" />
        <MenuItem Tag="Encoding" Click="OnAction" />
        <MenuItem Tag="Reload" Click="OnAction" />
        <MenuItem Tag="Print" InputGesture="Ctrl+P" Click="OnAction" />
        <Separator />
        <MenuItem Header="_Close" InputGesture="Ctrl+W" Tag="Close" Click="OnAction" />
        <MenuItem x:Name="RecentMenu" Header="Recent _Files" />
        <Separator />
        <MenuItem Header="New _PowerShell Tab" InputGesture="Ctrl+T" Tag="NewSession" Click="OnAction" />
        <MenuItem Tag="NewRemoteSession" Click="OnAction" />
        <MenuItem Tag="OpenRemoteFile" Click="OnAction" />
        <MenuItem Tag="ExitRemoteSession" Click="OnAction" />
        <MenuItem Header="Close PowerShell Tab" InputGesture="Ctrl+Shift+W" Tag="CloseSession" Click="OnAction" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Alt+F4" Tag="Exit" Click="OnAction" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Tag="Undo" Click="OnAction" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Tag="Redo" Click="OnAction" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Tag="Cut" Click="OnAction" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Tag="Copy" Click="OnAction" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Tag="Paste" Click="OnAction" />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Tag="SelectAll" Click="OnAction" />
        <Separator />
        <MenuItem Header="_Find..." InputGesture="Ctrl+F" Tag="Find" Click="OnAction" />
        <MenuItem Header="_Replace..." InputGesture="Ctrl+H" Tag="Replace" Click="OnAction" />
        <MenuItem Header="_Go to Line..." InputGesture="Ctrl+G" Tag="GoToLine" Click="OnAction" />
        <MenuItem Header="Go to Matching _Brace" InputGesture="Ctrl+OemCloseBrackets" Tag="MatchBrace" Click="OnAction" />
        <MenuItem Header="Select to Matching Brace" InputGesture="Ctrl+Shift+OemCloseBrackets" Tag="SelectBrace" Click="OnAction" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Show Script Pane _Top" InputGesture="Ctrl+1" Tag="Top" Click="OnAction" />
        <MenuItem Header="Show Script Pane _Right" InputGesture="Ctrl+2" Tag="Right" Click="OnAction" />
        <MenuItem Header="Show Script Pane _Maximized" InputGesture="Ctrl+3" Tag="Maximized" Click="OnAction" />
        <Separator />
        <MenuItem Header="Show _Commands Pane" InputGesture="Ctrl+Shift+C" Tag="Commands" Click="OnAction" />
        <MenuItem Header="Show _Line Numbers" Tag="LineNumbers" Click="OnAction" />
        <MenuItem Header="_Word Wrap" Tag="WordWrap" Click="OnAction" />
        <MenuItem Header="Expand / Collapse Outlining" Tag="Fold" Click="OnAction" />
        <Separator />
        <MenuItem Header="Go to _Script Pane" InputGesture="Ctrl+I" Tag="FocusScript" Click="OnAction" />
        <MenuItem Header="Go to C_onsole Pane" InputGesture="Ctrl+D" Tag="FocusConsole" Click="OnAction" />
        <MenuItem Header="Zoom _In" InputGesture="Ctrl+OemPlus" Tag="ZoomIn" Click="OnAction" />
        <MenuItem Header="Zoom _Out" InputGesture="Ctrl+OemMinus" Tag="ZoomOut" Click="OnAction" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Run Script" InputGesture="F5" Tag="Run" Click="OnAction" />
        <MenuItem Header="Run _Selection" InputGesture="F8" Tag="RunSelection" Click="OnAction" />
        <MenuItem Header="_Stop Operation" InputGesture="Ctrl+Pause" Tag="Stop" Click="OnAction" />
        <Separator />
        <MenuItem Header="Start _IntelliSense" InputGesture="Ctrl+Space" Tag="Complete" Click="OnAction" />
        <MenuItem Header="Show Command..." InputGesture="Ctrl+F1" Tag="ShowCommand" Click="OnAction" />
        <MenuItem Header="_Snippets..." InputGesture="Ctrl+J" Tag="Snippets" Click="OnAction" />
        <MenuItem Header="Create Snippet..." Tag="CreateSnippet" Click="OnAction" />
        <MenuItem Header="Import Snippets..." Tag="ImportSnippets" Click="OnAction" />
        <MenuItem Header="Export Snippets..." Tag="ExportSnippets" Click="OnAction" />
        <MenuItem Header="Clear _Console Pane" InputGesture="Ctrl+L" Tag="Clear" Click="OnAction" />
        <Separator />
        <MenuItem Header="Load PowerShell _Profiles" Tag="Profiles" Click="OnAction" />
        <MenuItem Header="Load profiles in new PowerShell tabs" Tag="AutoProfiles" ToggleType="CheckBox" Click="OnAction" />
        <MenuItem Header="Enable Local Scripts (Process Only)..." Tag="ExecutionPolicy" Click="OnAction" />
        <MenuItem Header="_Options..." Tag="Options" Click="OnAction" />
      </MenuItem>
      <MenuItem Header="_Debug">
        <MenuItem Header="Toggle _Breakpoint" InputGesture="F9" Tag="Breakpoint" Click="OnAction" />
        <MenuItem Header="Debugger Panes" Tag="DebuggerPanes" Click="OnAction" />
        <MenuItem Header="New Breakpoint..." Tag="NewBreakpoint" Click="OnAction" />
        <MenuItem Header="Break All" InputGesture="Ctrl+Alt+Pause" Tag="BreakAll" Click="OnAction" />
        <MenuItem Header="_Remove All Breakpoints" InputGesture="Ctrl+Shift+F9" Tag="RemoveBreakpoints" Click="OnAction" />
        <Separator />
        <MenuItem Header="Step _Into" InputGesture="F11" Tag="StepInto" Click="OnAction" />
        <MenuItem Header="Step _Over" InputGesture="F10" Tag="StepOver" Click="OnAction" />
        <MenuItem Header="Step O_ut" InputGesture="Shift+F11" Tag="StepOut" Click="OnAction" />
        <MenuItem Header="_Continue" InputGesture="F5" Tag="Continue" Click="OnAction" />
        <MenuItem Header="_Stop Debugger" InputGesture="Shift+F5" Tag="Stop" Click="OnAction" />
      </MenuItem>
      <MenuItem x:Name="AddonsMenu" Header="_Add-ons">
        <MenuItem Header="Show _Commands" Tag="Commands" Click="OnAction" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="PowerShell Command _Help" InputGesture="F1" Tag="Help" Click="OnAction" />
        <MenuItem Header="{local:Ui CheckForUpdatesMenu}" Tag="CheckForUpdates" Click="OnAction" />
        <MenuItem Header="_About Iseberg" Tag="About" Click="OnAction" />
      </MenuItem>
    </Menu>
    <Border x:Name="WorkbenchToolbar" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="4,1">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <Button Classes="tool" Tag="New" Click="OnAction" ToolTip.Tip="New (Ctrl+N)" AutomationProperties.Name="New script"><local:ToolbarIcon Kind="New" /></Button>
        <Button Classes="tool" Tag="Open" Click="OnAction" ToolTip.Tip="Open (Ctrl+O)" AutomationProperties.Name="Open script"><local:ToolbarIcon Kind="Open" /></Button>
        <Button Classes="tool" Tag="Save" Click="OnAction" ToolTip.Tip="Save (Ctrl+S)" AutomationProperties.Name="Save script"><local:ToolbarIcon Kind="Save" /></Button>
        <Button Classes="tool" Tag="SaveAll" Click="OnAction" ToolTip.Tip="Save all" AutomationProperties.Name="Save all"><local:ToolbarIcon Kind="SaveAll" /></Button>
        <Border Width="1" Margin="5,3" Background="#BABABA" />
        <Button Classes="tool" Tag="Cut" Click="OnAction" ToolTip.Tip="Cut (Ctrl+X)" AutomationProperties.Name="Cut"><local:ToolbarIcon Kind="Cut" /></Button>
        <Button Classes="tool" Tag="Copy" Click="OnAction" ToolTip.Tip="Copy (Ctrl+C)" AutomationProperties.Name="Copy"><local:ToolbarIcon Kind="Copy" /></Button>
        <Button Classes="tool" Tag="Paste" Click="OnAction" ToolTip.Tip="Paste (Ctrl+V)" AutomationProperties.Name="Paste"><local:ToolbarIcon Kind="Paste" /></Button>
        <Border Width="1" Margin="5,3" Background="#BABABA" />
        <Button Classes="tool" Tag="Undo" Click="OnAction" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><local:ToolbarIcon Kind="Undo" /></Button>
        <Button Classes="tool" Tag="Redo" Click="OnAction" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><local:ToolbarIcon Kind="Redo" /></Button>
        <Border Width="1" Margin="5,3" Background="#BABABA" />
        <Button x:Name="RunButton" Classes="tool" Tag="Run" Click="OnAction" ToolTip.Tip="Run script / Continue (F5)" AutomationProperties.Name="Run script"><local:ToolbarIcon Kind="Run" /></Button>
        <Button x:Name="SelectionButton" Classes="tool" Tag="RunSelection" Click="OnAction" ToolTip.Tip="Run selection (F8)" AutomationProperties.Name="Run selection"><local:ToolbarIcon Kind="Selection" /></Button>
        <Button x:Name="StopButton" Classes="tool" Tag="Stop" Click="OnAction" ToolTip.Tip="Stop operation (Ctrl+Break)" AutomationProperties.Name="Stop operation"><local:ToolbarIcon Kind="Stop" /></Button>
        <Border Width="1" Margin="5,3" Background="#BABABA" />
        <Button Classes="tool" Tag="Top" Click="OnAction" ToolTip.Tip="Script pane top (Ctrl+1)" AutomationProperties.Name="Script pane top"><local:ToolbarIcon Kind="Top" /></Button>
        <Button Classes="tool" Tag="Right" Click="OnAction" ToolTip.Tip="Script pane right (Ctrl+2)" AutomationProperties.Name="Script pane right"><local:ToolbarIcon Kind="Right" /></Button>
        <Button Classes="tool" Tag="Maximized" Click="OnAction" ToolTip.Tip="Script pane maximized (Ctrl+3)" AutomationProperties.Name="Script pane maximized"><local:ToolbarIcon Kind="Maximized" /></Button>
        <Button Classes="tool" Tag="Commands" Click="OnAction" ToolTip.Tip="Show commands (Ctrl+Shift+C)" AutomationProperties.Name="Commands pane"><local:ToolbarIcon Kind="Commands" /></Button>
      </StackPanel>
    </Border>
    <TabStrip Grid.Row="2" x:Name="SessionTabs" IsVisible="{Binding ShowSessionTabs}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionChanged="OnSessionChanged" Background="{DynamicResource ControlBrush}">
      <TabStrip.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
            <Button Classes="close" Click="OnCloseSession" ToolTip.Tip="{local:Ui ClosePowerShellTab}" AutomationProperties.Name="{local:Ui ClosePowerShellTab}"><local:ToolbarIcon Kind="Close" Width="10" Height="10" /></Button>
          </StackPanel>
        </DataTemplate>
      </TabStrip.ItemTemplate>
    </TabStrip>
    <Grid Grid.Row="3" x:Name="OuterGrid" ColumnDefinitions="*,5,290,0,0">
      <Grid x:Name="PaneGrid" RowDefinitions="3*,5,2*" ColumnDefinitions="*">
        <Grid x:Name="ScriptPane" RowDefinitions="Auto,*,Auto" Background="White">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ControlBrush}">
            <TabStrip x:Name="FileTabs" ItemsSource="{Binding SelectedSession.Files}" SelectedItem="{Binding SelectedSession.SelectedFile, Mode=OneWay}" SelectionChanged="OnFileChanged">
              <TabStrip.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding File.Title}" VerticalAlignment="Center" />
                    <Button Classes="close" Click="OnCloseFile" ToolTip.Tip="{local:Ui CloseScript}" AutomationProperties.Name="{local:Ui CloseScript}"><local:ToolbarIcon Kind="Close" Width="10" Height="10" /></Button>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
          </Border>
          <local:AccessibleTextEditor x:Name="ScriptEditor" Grid.Row="1" ShowLineNumbers="True"
                           FontFamily="Consolas, Cascadia Code, DejaVu Sans Mono, Menlo, monospace"
                           FontSize="16" Background="White" Foreground="Black"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           AutomationProperties.Name="Script editor" />
          <TextBlock Grid.Row="2" x:Name="Diagnostics" Foreground="{DynamicResource WindowTextBrush}" Background="{DynamicResource WindowBrush}" Padding="5,2" IsVisible="False" TextWrapping="Wrap" MaxHeight="45" AutomationProperties.Name="Script diagnostics" />
        </Grid>
        <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlBrush}" AutomationProperties.Name="Script and console pane divider" />
        <Grid x:Name="ConsolePane" Grid.Row="2" RowDefinitions="*,Auto" Background="#012456">
          <local:AccessibleTextEditor x:Name="ConsoleEditor"
                           FontFamily="Consolas, Cascadia Code, DejaVu Sans Mono, Menlo, monospace"
                           FontSize="16" Background="#012456" Foreground="White"
                           WordWrap="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                           AutomationProperties.Name="PowerShell console" />
          <Border Grid.Row="1" x:Name="ProgressPanel" IsVisible="False" Background="{DynamicResource ControlBrush}" Padding="8,4" VerticalAlignment="Bottom">
            <StackPanel Spacing="3">
              <TextBlock x:Name="ProgressText" />
              <ProgressBar x:Name="ScriptProgress" Minimum="0" Maximum="100" Height="8" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" x:Name="DebuggerSplitter" IsVisible="False" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource ControlBrush}" AutomationProperties.Name="{local:Ui DebuggerPaneDivider}" />
      <Border Grid.Column="2" x:Name="DebuggerPane" IsVisible="False" MinWidth="340" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource ControlBrush}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="7">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{local:Ui DebuggerPanes}" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{local:Ui Refresh}" Tag="RefreshDebugger" Click="OnAction" />
            <Button Grid.Column="2" Classes="close" Tag="DebuggerPanes" Click="OnAction" AutomationProperties.Name="{local:Ui CloseDebuggerPanes}"><local:ToolbarIcon Kind="Close" Width="10" Height="10" /></Button>
          </Grid>
          <TextBlock Grid.Row="1" x:Name="DebuggerScope" Text="{local:Ui DebuggerEvaluationScope}" TextWrapping="Wrap" Margin="0,5" />
          <TabControl Grid.Row="2" x:Name="DebuggerTabs">
            <TabItem Header="{local:Ui Variables}">
              <TreeView x:Name="VariablesList" AutomationProperties.Name="{local:Ui Variables}" />
            </TabItem>
            <TabItem Header="{local:Ui Watches}">
              <Grid RowDefinitions="Auto,*">
                <DockPanel Margin="0,3">
                  <Button x:Name="RemoveWatchButton" DockPanel.Dock="Right" Content="{local:Ui RemoveWatch}" Tag="RemoveWatch" Click="OnAction" />
                  <Button DockPanel.Dock="Right" Content="{local:Ui AddWatch}" Tag="AddWatch" Click="OnAction" />
                  <TextBox x:Name="WatchExpression" Watermark="{local:Ui WatchExpression}" AutomationProperties.Name="{local:Ui WatchExpression}" />
                </DockPanel>
                <TreeView Grid.Row="1" x:Name="WatchesList" SelectionChanged="OnWatchSelected" AutomationProperties.Name="{local:Ui Watches}" />
              </Grid>
            </TabItem>
            <TabItem Header="{local:Ui CallStack}">
              <ListBox x:Name="CallStackList" SelectionChanged="OnDebugScopeSelected" DoubleTapped="OnDebugFrameSelected" AutomationProperties.Name="{local:Ui CallStack}" />
            </TabItem>
            <TabItem Header="{local:Ui BreakpointsTitle}">
              <Grid RowDefinitions="Auto,*">
                <WrapPanel>
                  <Button x:Name="NewBreakpointButton" Content="{local:Ui NewBreakpoint}" Tag="NewBreakpoint" Click="OnAction" />
                  <Button x:Name="EditBreakpointButton" Content="{local:Ui EditBreakpoint}" Tag="EditBreakpoint" Click="OnAction" />
                  <Button x:Name="EnableBreakpointButton" Content="{local:Ui EnableDisableBreakpoint}" Tag="EnableBreakpoint" Click="OnAction" />
                  <Button x:Name="DeleteBreakpointButton" Content="{local:Ui DeleteBreakpoint}" Tag="DeleteBreakpoint" Click="OnAction" />
                </WrapPanel>
                <ListBox Grid.Row="1" x:Name="BreakpointsList" SelectionChanged="OnBreakpointSelected" AutomationProperties.Name="{local:Ui BreakpointsTitle}" />
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" x:Name="CommandSplitter" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlBrush}" AutomationProperties.Name="Commands pane divider" />
      <Border Grid.Column="2" x:Name="CommandsPane" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,2*,5,3*,Auto" Margin="7">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{local:Ui CommandsTitle}" FontWeight="Bold" Margin="0,2,0,8" />
            <Button Grid.Column="1" Classes="close" Tag="Commands" Click="OnAction" AutomationProperties.Name="{local:Ui Commands}"><local:ToolbarIcon Kind="Close" Width="10" Height="10" /></Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,7">
            <TextBlock Text="{local:Ui Modules}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ModuleFilter" Grid.Column="1" SelectionChanged="OnCommandFilterChanged" MinHeight="26" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Ui Modules}" />
          </Grid>
          <TextBox Grid.Row="2" x:Name="CommandSearch" Watermark="{local:Ui Name}" TextChanged="OnCommandSearchChanged" Margin="0,0,0,7" AutomationProperties.Name="Command search" />
          <ListBox Grid.Row="3" x:Name="CommandList" Background="{DynamicResource WindowBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="OnCommandSelected" DoubleTapped="OnInsertCommand" AutomationProperties.Name="{local:Ui CommandsTitle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource WindowTextBrush}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Ui CommandFormDivider}" />
          <local:CommandFormView Grid.Row="5" x:Name="CommandForm" Margin="0,5" />
          <WrapPanel Grid.Row="6" HorizontalAlignment="Right">
            <Button x:Name="CommandRefreshButton" Content="{local:Ui Refresh}" Tag="RefreshCommands" Click="OnAction" />
            <Button x:Name="CommandHelpButton" Content="{local:Ui HelpButton}" Tag="CommandHelp" Click="OnAction" />
            <Button x:Name="CommandCopyButton" Content="{local:Ui CopyCommand}" Tag="CopyCommand" Click="OnAction" />
            <Button x:Name="CommandInsertButton" Content="{local:Ui Insert}" Tag="InsertCommand" Click="OnAction" />
            <Button x:Name="CommandRunButton" Content="{local:Ui RunButton}" Tag="RunCommand" Click="OnAction" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="WorkbenchStatusBar" Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ControlBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="5,2">
        <TextBlock x:Name="StatusText" Text="{local:Ui Starting}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="1" x:Name="CaretText" Text="Ln 1  Col 1" Width="125" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" x:Name="EncodingText" Text="UTF-8" Width="90" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Width="38" />
          <Slider x:Name="ZoomSlider" Minimum="20" Maximum="400" Value="100" Width="110" ValueChanged="OnZoomChanged" AutomationProperties.Name="Zoom percentage" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
