<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Iseberg"
             x:Class="Iseberg.CommandFormView">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="4">
    <TextBlock x:Name="CommandTitle" FontWeight="Bold" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" x:Name="SetPanel" Spacing="3" IsVisible="False">
      <TextBlock Text="{local:Ui ParameterSet}" />
      <ComboBox x:Name="ParameterSetPicker" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{local:Ui ParameterSet}" />
      <ScrollViewer x:Name="ParameterSetTabScroll" IsVisible="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <TabStrip x:Name="ParameterSetTabs" IsVisible="False" AutomationProperties.Name="{local:Ui ParameterSet}" />
      </ScrollViewer>
    </StackPanel>
    <Border Grid.Row="2" x:Name="ParameterFrame" BorderThickness="0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Parameters" Spacing="4" />
      </ScrollViewer>
    </Border>
    <Expander Grid.Row="3" x:Name="CommonParameterExpander" Header="{local:Ui CommonParameters}" IsVisible="False"
              HorizontalAlignment="Stretch">
      <ScrollViewer MaxHeight="170" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="CommonParameters" Spacing="4" />
      </ScrollViewer>
    </Expander>
    <Expander Grid.Row="4" x:Name="PreviewExpander" Header="{local:Ui CommandPreview}" IsExpanded="True" HorizontalAlignment="Stretch">
      <TextBox x:Name="CommandPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               MaxHeight="100" FontSize="11" AutomationProperties.Name="{local:Ui CommandPreview}" />
    </Expander>
    <TextBlock Grid.Row="5" x:Name="CommandValidation" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
