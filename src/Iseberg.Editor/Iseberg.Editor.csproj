<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PoshTools.Iseberg.Editor</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Engine-independent PowerShell editing and explicit host-provided diagnostics for Avalonia 12. No execution or workbench.</Description>
    <PackageReadmeFile>editor-hosting.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\docs\nuget-hosting.md" />
    <PackageReference Include="Avalonia" Version="[12.1.3]" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="[12.0.0]" />
    <None Include="..\..\docs\editor-hosting.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\editor-notices.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
