<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PoshTools.Iseberg.Core</PackageId>
    <Description>PowerShell execution, completion, debugging, and editor services for Iseberg.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6">
      <ExcludeAssets Condition="'$(IsebergCompact)' == 'true'">runtime;contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
